---
const { publication }=Astro.props;
const {key,title,authors,venue,year,preview,links,abstract,bibtex}=publication.data;
---
<article class="pub" id={key}>
  <div class="pub-side">{preview ? <img class="teaser" src={preview} alt="" loading="lazy"/> : <div class="placeholder">{year}</div>}</div>
  <div>
    <h3>{title}</h3>
    <p class="authors">{authors.map((a,i)=><span>{a.self?<strong>{a.name}</strong>:a.name}{i<authors.length-1?', ':''}</span>)}</p>
    <p class="muted"><em>{venue}</em> {year}</p>
    <div class="links">{links.arxiv&&<a class="btn" href={links.arxiv}>arXiv</a>}{links.code&&<a class="btn" href={links.code}>Code</a>}{links.website&&<a class="btn" href={links.website}>Webpage</a>}{links.venue&&<a class="btn" href={links.venue}>{venue}</a>}{abstract&&<details><summary class="btn">Abs</summary><p>{abstract}</p></details>}{bibtex&&<details><summary class="btn">Bib</summary><pre>{bibtex}</pre></details>}</div>
  </div>
</article>
<style>
.pub{display:grid;grid-template-columns:200px 1fr;gap:1.5rem;padding-block:1.5rem;border-bottom:1px solid var(--border)}.teaser,.placeholder{width:100%;aspect-ratio:4/3;object-fit:contain;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius)}.placeholder{display:grid;place-items:center;color:var(--text-muted);font-size:1.3rem}.authors{font-size:.925rem;margin-top:.3rem}.links{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:.7rem}.links details{display:inline}.links details p,.links pre{margin-top:.7rem;background:var(--surface);padding:.7rem;max-width:60ch;white-space:pre-wrap}summary{cursor:pointer;list-style:none}@media(max-width:640px){.pub{grid-template-columns:1fr}.pub-side{max-width:280px}}
</style>
